#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f /run/.containerenv ]]; then
    echo "Run this script inside the dev container." >&2
    exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIBEXEC=/usr/local/libexec/dev-container
HOST_EXEC="$LIBEXEC/distrobox-host-exec"

if [[ /usr/bin/flatpak -ef /usr/bin/distrobox-host-exec && ! -x "$LIBEXEC/flatpak-native" ]]; then
    sudo dnf reinstall -y flatpak
fi
if [[ ! /usr/bin/flatpak -ef /usr/bin/distrobox-host-exec ]]; then
    sudo install -D -m 0755 /usr/bin/flatpak "$LIBEXEC/flatpak-native"
fi
sudo install -D -m 0755 "$SCRIPT_DIR/flatpak-build" "$LIBEXEC/flatpak-build"
sudo install -d "$LIBEXEC/flatpak-build-bin"
sudo ln -sf "$LIBEXEC/flatpak-build" "$LIBEXEC/flatpak-build-bin/flatpak"
sudo ln -sf "$LIBEXEC/flatpak-build" "$LIBEXEC/flatpak-build-bin/flatpak-builder"
sudo ln -sf "$LIBEXEC/flatpak-build" /usr/local/bin/flatpak-builder

for command in dbus-run-session gio podman distrobox systemctl flatpak; do
    sudo ln -sf /usr/bin/distrobox-host-exec "/usr/local/bin/$command"
done

# Vite+ can put /usr/bin before /usr/local/bin.
sudo ln -sf /usr/bin/distrobox-host-exec /usr/bin/flatpak

sudo install -D -m 0755 "$SCRIPT_DIR/host-desktop-exec" "$HOST_EXEC"
if [[ ! /usr/bin/xdg-open -ef /usr/bin/distrobox-host-exec &&
      ! /usr/bin/xdg-open -ef "$HOST_EXEC" ]]; then
    sudo install -D -m 0755 /usr/bin/xdg-open /usr/local/libexec/dev-container/xdg-open
fi

# Vite+ puts /usr/bin before /usr/local/bin.
sudo ln -sf "$HOST_EXEC" /usr/bin/xdg-open
sudo ln -sf "$HOST_EXEC" /usr/local/bin/xdg-open
