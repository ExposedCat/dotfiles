FROM quay.io/fedora/fedora-toolbox:latest

ENV H=/var/home/kitkat

# DNF
RUN dnf install -y dnf-plugins-core

# Repos
RUN dnf copr enable -y atim/starship
RUN dnf copr enable -y che/nerd-fonts
RUN dnf copr enable -y exposedcat/pm3
RUN curl -fsSL https://rpm.nodesource.com/setup_current.x | sudo bash -

# Packages
RUN dnf install -y \
    fish \
    podman-compose \
    ffmpeg \
    starship \
    nodejs \
    fontconfig \
    nerd-fonts \
    libxkbfile \
    xdg-utils \
    fastfetch \
    jq \
    httpie \
    pm3 \
    python3 \
    rpm-build \
    rpmdevtools \
    bubblewrap \
    xorg-x11-server-Xvfb \
    xorg-x11-xauth \
    xdpyinfo \
    xprop \
    xdotool \
    openbox \
    ImageMagick \
    dbus-daemon \
    git gcc gcc-c++ clang make pkgconf-pkg-config rustup \
    systemd-devel fontconfig-devel wayland-devel libxkbcommon-x11-devel \
    libX11-devel libxcb-devel openssl-devel libzstd-devel alsa-lib-devel \
    libusb1-devel squashfs-tools flatpak flatpak-builder \
    meson ninja-build glib2-devel json-glib-devel fuse3-devel gdk-pixbuf2-devel \
    gstreamer1-plugins-base-devel geoclue2-devel pipewire-devel libgudev-devel flatpak-devel

# Preserve the native CLI for builds before setting up host forwarding.
RUN install -D -m 0755 /usr/bin/flatpak /usr/local/libexec/dev-container/flatpak-native \
    && ln -sf /usr/bin/distrobox-host-exec /usr/bin/flatpak \
    && ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/flatpak

RUN npm install -g corepack@0.34.5

# Cleanup
RUN dnf clean all

# Shell
ENV SHELL_CONF=/etc/fish/conf.d
RUN mkdir -p $SHELL_CONF
COPY fish/*.fish $SHELL_CONF/

# Codex
RUN npm i -g @openai/codex

# Deno
RUN npm	i -g deno
RUN deno completions fish > $SHELL_CONF/deno.fish
RUN chmod +x $SHELL_CONF/deno.fish

# Godot
RUN wget https://codeberg.org/godotsteam/godotsteam/releases/download/v4.17.1/linux64-g46-s163-gs4171-editor.tar.xz
RUN tar -xvf linux64-g46-s163-gs4171-editor.tar.xz
RUN mkdir -p $H/Applications/godot
RUN mv godotsteam.46.editor.x86_64 $H/Applications/godot/editor
RUN mv libsteam_api.so $H/Applications/godot
RUN rm linux64-g46-s163-gs4171-editor.tar.xz
RUN chmod +x $H/Applications/godot/editor

CMD ["fish"]
