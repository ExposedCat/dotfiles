#!/usr/bin/env bash
set -euo pipefail

NAME=dev
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"

podman build -t "$NAME" -f "$SCRIPT_DIR/Containerfile" "$REPO_ROOT"
distrobox create --name $NAME --image $NAME --yes

distrobox enter "$NAME" -- bash "$SCRIPT_DIR/setup-host-commands"

distrobox enter $NAME -- bash -lc '
    distrobox-export --app code
'

echo "DONE"
