#!/usr/bin/env bash
set -euo pipefail

host_command="${0##*/}"
if [[ "$host_command" == distrobox-host-exec ]]; then
    host_command="${1:?Specify a host command}"
    shift
fi
if [[ "$host_command" != /* ]]; then
    host_command="/usr/bin/$host_command"
fi

export XDG_RUNTIME_DIR="/run/host/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# The host-spawn service can retain a different desktop's environment. Forward
# the calling terminal's display as well as tokens for browser activation.
forward_env=TERM,XDG_ACTIVATION_TOKEN,DESKTOP_STARTUP_ID
for name in DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE; do
    if [[ -n "${!name:-}" ]]; then
        forward_env+=",$name"
    fi
done

exec /usr/bin/host-spawn --no-pty \
    --env="$forward_env" \
    /usr/bin/env "XDG_RUNTIME_DIR=/run/user/$(id -u)" \
    "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus" \
    "$host_command" "$@"
