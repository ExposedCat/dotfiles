#!/usr/bin/env bash
set -euo pipefail

directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
codex_skills=$HOME/.codex/skills
claude_directory=$HOME/.claude
antigravity_directory=$HOME/.gemini/config
mkdir -p "$codex_skills"

tar --exclude=__pycache__ --exclude='*.py[co]' -C "$directory/../codex/skills" -cf - . |
    tar --no-overwrite-dir --keep-directory-symlink -C "$codex_skills" -xf -

link_skills() {
    local label=$1
    local target_directory=$2
    local target_skills=$target_directory/skills
    local backup= entry target link_target

    mkdir -p "$target_directory"
    if [[ -L $target_skills && $target_skills -ef $codex_skills ]]; then
        return 0
    fi

    if [[ -e $target_skills || -L $target_skills ]]; then
        if [[ -d $target_skills ]]; then
            shopt -s dotglob nullglob
            for entry in "$target_skills"/*; do
                target=$codex_skills/${entry##*/}
                [[ ! -e $target && ! -L $target ]] || continue
                if [[ -L $entry ]]; then
                    link_target=$(realpath -m -- "$entry")
                    [[ $link_target != "$target" ]] || continue
                    ln -sT -- "$link_target" "$target"
                else
                    cp -aT -- "$entry" "$target"
                fi
            done
            shopt -u dotglob nullglob
        fi
        backup=$(mktemp -d "$target_directory/skills-backup.XXXXXX")
        mv -T -- "$target_skills" "$backup/skills"
        printf 'Previous %s skills directory saved in %s\n' "$label" "$backup/skills"
    fi

    if ! ln -sT -- "$codex_skills" "$target_skills"; then
        if [[ -n $backup && ! -e $target_skills && ! -L $target_skills ]]; then
            mv -T -- "$backup/skills" "$target_skills"
        fi
        exit 1
    fi
}

link_skills Claude "$claude_directory"
link_skills Antigravity "$antigravity_directory"

cp -- "$directory/CLAUDE.md" "$claude_directory/CLAUDE.md"
