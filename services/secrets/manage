#!/usr/bin/env bash
set -euo pipefail

script=$(realpath "${BASH_SOURCE[0]}")
source_dir=$(dirname "$script")
case "${1:-}" in
    install|check|seal) ;;
    *) echo "Usage: $0 {install|check|seal}" >&2; exit 2 ;;
esac

if [[ -e /run/.containerenv || -e /.dockerenv ]]; then
    exec distrobox-host-exec bash "$script" "$@"
fi

rpm -q oo7-daemon pam_oo7 gnome-online-accounts >/dev/null
credential_name=oo7.keyring-encryption-password
credential=${XDG_CONFIG_HOME:-$HOME/.config}/credstore.encrypted/$credential_name

# Report whether a sealed password opens a copy of the login keyring. A private
# oo7 instance on its own bus checks it; the running keyring is not touched.
unlocks() {
    local work
    work=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/oo7-seal.XXXXXX")
    mkdir -p "$work/data/keyrings"
    cp -r "${XDG_DATA_HOME:-$HOME/.local/share}/keyrings/v1" "$work/data/keyrings/"
    local result
    result=$(systemd-run --user --quiet --wait --pipe \
        -p LoadCredentialEncrypted="$credential_name:$1" \
        -E HOME="$work" -E XDG_DATA_HOME="$work/data" -E OO7_PAM_SOCKET="$work/pam.sock" \
        dbus-run-session -- bash -c '
            /usr/libexec/oo7-daemon >/dev/null 2>&1 & pid=$!
            for _ in $(seq 50); do
                busctl --user status org.freedesktop.secrets >/dev/null 2>&1 && break
                sleep 0.1
            done
            busctl --user get-property org.freedesktop.secrets \
                /org/freedesktop/secrets/aliases/default \
                org.freedesktop.Secret.Collection Locked
            kill "$pid"' 2>/dev/null) || true
    rm -rf "$work"
    [[ $result == 'b false' ]]
}

if [[ ${1:-} == seal ]]; then
    # Store the keyring password encrypted with this PC's TPM so oo7 can unlock
    # the login keyring without a login screen. Only this user on this PC can
    # decrypt it. Rerun after changing the account password.
    [[ -f ${XDG_DATA_HOME:-$HOME/.local/share}/keyrings/v1/login.keyring ]] \
        || { echo 'No oo7 login keyring exists yet.' >&2; exit 1; }
    install -d -m 0700 "$(dirname "$credential")"
    for _ in 1 2 3; do
        systemd-ask-password -n --emoji=no 'Login keyring password (your account password):' \
            | systemd-creds --user encrypt --name="$credential_name" - "$credential.new"
        chmod 0600 "$credential.new"
        if unlocks "$credential.new"; then
            mv "$credential.new" "$credential"
            echo 'The keyring now unlocks automatically when oo7 starts.'
            exit 0
        fi
        rm -f "$credential.new"
        echo 'That password does not open the login keyring. Try again.' >&2
    done
    exit 1
fi
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
activation_dir=${XDG_DATA_HOME:-$HOME/.local/share}/dbus-1/services
goa_unit=dotfiles-goa-daemon.service
goa_name=org.gnome.OnlineAccounts
bus=(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus)

configure() {
    local source=$source_dir/$1 target=$2
    if [[ $action == install ]] && ! cmp -s "$source" "$target"; then
        if [[ -e $target ]]; then
            cp -a "$target" "$target.before-$(date +%Y%m%dT%H%M%S-%N)"
        fi
        install -Dm0644 "$source" "$target"
    fi
    cmp "$source" "$target"
}

action=$1
configure "$goa_unit" "$unit_dir/$goa_unit"
configure session.conf "$unit_dir/oo7-daemon.service.d/dotfiles-session.conf"
configure "$goa_name.service" "$activation_dir/$goa_name.service"

if [[ $action == install ]]; then
    systemctl --user daemon-reload
    # Replace any old default.target link so startup follows desktop login.
    systemctl --user reenable oo7-daemon.service
    "${bus[@]}" ReloadConfig
    if systemctl --user is-active --quiet graphical-session.target; then
        systemctl --user start oo7-daemon.service
    fi
    # Move a running vendor-activated daemon into the named unit once.
    legacy_goa='dbus-*-org.gnome.OnlineAccounts@*.service'
    if systemctl --user is-active --quiet "$legacy_goa"; then
        systemctl --user stop "$legacy_goa"
        "${bus[@]}" StartServiceByName su "$goa_name" 0 >/dev/null
    fi
fi

systemctl --user is-enabled --quiet oo7-daemon.service
if systemctl --user is-active --quiet graphical-session.target; then
    systemctl --user is-active --quiet oo7-daemon.service
    "${bus[@]}" GetNameOwner s org.freedesktop.secrets >/dev/null
fi
goa_owner=$("${bus[@]}" NameHasOwner s "$goa_name")
if [[ $goa_owner == 'b true' ]]; then
    systemctl --user is-active --quiet "$goa_unit" || {
        echo 'GNOME Online Accounts is running outside its configured unit.' >&2
        exit 1
    }
fi
echo 'oo7 and GNOME Online Accounts startup and recovery configuration matches.'
