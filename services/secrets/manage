#!/usr/bin/env bash
set -euo pipefail

script=$(realpath "${BASH_SOURCE[0]}")
source_dir=$(dirname "$script")
case "${1:-}" in
    install|check) ;;
    *) echo "Usage: $0 {install|check}" >&2; exit 2 ;;
esac

if [[ -e /run/.containerenv || -e /.dockerenv ]]; then
    exec distrobox-host-exec bash "$script" "$@"
fi

rpm -q oo7-daemon pam_oo7 >/dev/null
target=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/oo7-daemon.service.d/dotfiles-session.conf

if [[ $1 == install ]]; then
    if ! cmp -s "$source_dir/session.conf" "$target"; then
        if [[ -e $target ]]; then
            cp -a "$target" "$target.before-$(date +%Y%m%dT%H%M%S-%N)"
        fi
        install -Dm0644 "$source_dir/session.conf" "$target"
    fi
    systemctl --user daemon-reload
    # Replace the old default.target link: lingering alone must not unlock secrets.
    systemctl --user reenable oo7-daemon.service
    if systemctl --user is-active --quiet graphical-session.target; then
        systemctl --user start oo7-daemon.service
    fi
fi

cmp "$source_dir/session.conf" "$target"
systemctl --user is-enabled --quiet oo7-daemon.service
if systemctl --user is-active --quiet graphical-session.target; then
    systemctl --user is-active --quiet oo7-daemon.service
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus GetNameOwner s org.freedesktop.secrets >/dev/null
fi
echo 'oo7 desktop startup and recovery configuration matches.'
