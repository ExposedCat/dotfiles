#!/usr/bin/env bash

# Codex: install the isolated GUI skill without generated Python caches.
mkdir -p ~/.codex/skills/isolated-gui/{agents,scripts}
cp ./codex/skills/isolated-gui/SKILL.md ~/.codex/skills/isolated-gui/
cp ./codex/skills/isolated-gui/agents/openai.yaml ~/.codex/skills/isolated-gui/agents/
cp ./codex/skills/isolated-gui/scripts/{desktop,runtime,test_runtime}.py ~/.codex/skills/isolated-gui/scripts/

# Codex: install the server workflow skill.
mkdir -p ~/.codex/skills/server/agents
cp ./codex/skills/server/SKILL.md ~/.codex/skills/server/
cp ./codex/skills/server/agents/openai.yaml ~/.codex/skills/server/agents/

# Claude: share the installed Codex server and isolated GUI workflows.
mkdir -p ~/.claude
cp ./claude/CLAUDE.md ~/.claude/CLAUDE.md

# System sleep: install on the host, including when called from Distrobox.
./services/sleep/manage install

# LAN hostname resolution on this PC.
./services/mdns/manage install

# Secret Service: start oo7 for each desktop session and recover after bus loss.
./services/secrets/manage install

# Build and install the pinned Papers, Bazecor and OpenLogi forks and wl-screenrec.
./apps/manage install all

# Fastfetch
cp ./fastfetch/* ~/.config/fastfetch/

# Fish
sudo cp fish/* /etc/fish/conf.d

# System font fallback
./fonts/manage install

# Ptyxis
./ptyxis/manage install

# GTK client decorations
mkdir -p ~/.config/gtk-{3,4}.0
cp ./gtk/gtk.css ~/.config/gtk-3.0/gtk.css
cp ./gtk/gtk.css ~/.config/gtk-4.0/gtk.css

# PrusaSlicer's bundled GTK chooser needs GVfs to list and mount removable drives.
prusa_flatpak_host=()
if [[ -e /run/.containerenv || -e /.dockerenv ]]; then
    prusa_flatpak_host=(distrobox-host-exec)
fi
"${prusa_flatpak_host[@]}" flatpak override --user \
    '--talk-name=org.gtk.vfs.*' --filesystem=xdg-run/gvfsd \
    com.prusa3d.PrusaSlicer

# Remove the retired Brevlada entry only after migration to the installed app ID.
brevlada_old_autostart=${XDG_CONFIG_HOME:-$HOME/.config}/autostart/io.github.ExposedCat.Brevlada.desktop
if "${prusa_flatpak_host[@]}" flatpak info com.chipichapa.Brevlada >/dev/null 2>&1 \
    && ! "${prusa_flatpak_host[@]}" flatpak info io.github.ExposedCat.Brevlada >/dev/null 2>&1 \
    && [[ -f $brevlada_old_autostart ]] \
    && grep -qx 'X-Flatpak=io.github.ExposedCat.Brevlada' "$brevlada_old_autostart"; then
    rm -- "$brevlada_old_autostart"
fi

# Build the pinned local portal release and install its routing and dialogs.
./xdg-desktop-portal/manage install

# Audio: install profiles before enabling the WirePlumber rules.
mkdir -p ~/.config/alsa-card-profile/mixer/profile-sets ~/.config/wireplumber/wireplumber.conf.d
cp ./alsa-card-profile/mixer/profile-sets/{omen-hdmi5-only,podmic-input-only}.conf ~/.config/alsa-card-profile/mixer/profile-sets/ &&
    cp ./wireplumber/wireplumber.conf.d/{51-audio-output-cleanup,52-bluetooth-headphones-only}.conf ~/.config/wireplumber/wireplumber.conf.d/ &&
    systemctl --user restart wireplumber
