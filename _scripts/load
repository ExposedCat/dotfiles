#!/usr/bin/env bash

# VSCode
cp ./vscode/settings.json ~/.config/Code/User 

# Codex: install the isolated GUI skill without generated Python caches.
mkdir -p ~/.codex/skills/isolated-gui/{agents,scripts}
cp ./codex/skills/isolated-gui/SKILL.md ~/.codex/skills/isolated-gui/
cp ./codex/skills/isolated-gui/agents/openai.yaml ~/.codex/skills/isolated-gui/agents/
cp ./codex/skills/isolated-gui/scripts/{desktop,runtime}.py ~/.codex/skills/isolated-gui/scripts/

# Codex: install the server workflow skill.
mkdir -p ~/.codex/skills/server/agents
cp ./codex/skills/server/SKILL.md ~/.codex/skills/server/
cp ./codex/skills/server/agents/openai.yaml ~/.codex/skills/server/agents/

# LogiOps
sudo distrobox-host-exec cp logiops/logid.cfg /etc/logid.cfg
sudo mkdir -p /etc/systemd/system-sleep
sudo cp logiops/resume-fix /etc/systemd/system-sleep/after-resume

# System sleep: install on the host, including when called from Distrobox.
./services/sleep/manage install

# Fastfetch
cp ./fastfetch/* ~/.config/fastfetch/

# Fish
sudo cp fish/* /etc/fish/conf.d

# Ptyxis
dconf load /org/gnome/Ptyxis/ < ptyxis/ptyxis.dconf

# Audio: install profiles before enabling the WirePlumber rules.
mkdir -p ~/.config/alsa-card-profile/mixer/profile-sets ~/.config/wireplumber/wireplumber.conf.d
cp ./alsa-card-profile/mixer/profile-sets/{omen-hdmi5-only,podmic-input-only}.conf ~/.config/alsa-card-profile/mixer/profile-sets/ &&
    cp ./wireplumber/wireplumber.conf.d/{51-audio-output-cleanup,52-bluetooth-headphones-only}.conf ~/.config/wireplumber/wireplumber.conf.d/ &&
    systemctl --user restart wireplumber
