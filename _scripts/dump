#!/usr/bin/env bash

# VSCode
cp ~/.config/Code/User/settings.json ./vscode

# Codex: capture the isolated GUI skill without generated Python caches.
mkdir -p ./codex/skills/isolated-gui/{agents,scripts}
cp ~/.codex/skills/isolated-gui/SKILL.md ./codex/skills/isolated-gui/
cp ~/.codex/skills/isolated-gui/agents/openai.yaml ./codex/skills/isolated-gui/agents/
cp ~/.codex/skills/isolated-gui/scripts/{desktop,runtime}.py ./codex/skills/isolated-gui/scripts/

# Codex: capture the server workflow skill.
mkdir -p ./codex/skills/server/agents
cp ~/.codex/skills/server/SKILL.md ./codex/skills/server/
cp ~/.codex/skills/server/agents/openai.yaml ./codex/skills/server/agents/

# Claude: capture the global instructions that import the shared workflows.
mkdir -p ./claude
cp ~/.claude/CLAUDE.md ./claude/CLAUDE.md

# LogiOps
distrobox-host-exec cat /etc/logid.cfg > logiops/logid.cfg
distrobox-host-exec cp /etc/systemd/system-sleep/after-resume logiops/resume-fix

# System sleep: capture the host configuration and wake diagnostic helper.
./services/sleep/manage dump

# Fastfetch
cp ~/.config/fastfetch/* ./fastfetch

# Ptyxis
dconf dump /org/gnome/Ptyxis/ > ptyxis/ptyxis.dconf

# Audio: keep profile references independent of the local home directory.
mkdir -p ./alsa-card-profile/mixer/profile-sets ./wireplumber/wireplumber.conf.d
cp ~/.config/alsa-card-profile/mixer/profile-sets/{omen-hdmi5-only,podmic-input-only}.conf ./alsa-card-profile/mixer/profile-sets/
sed -E 's|(device\.profile-set = ")[^"]*/|\1|' \
    ~/.config/wireplumber/wireplumber.conf.d/51-audio-output-cleanup.conf \
    > ./wireplumber/wireplumber.conf.d/51-audio-output-cleanup.conf
cp ~/.config/wireplumber/wireplumber.conf.d/52-bluetooth-headphones-only.conf ./wireplumber/wireplumber.conf.d/
