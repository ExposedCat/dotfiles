#!/usr/bin/env bash
set -euo pipefail

launcher=$(realpath -- "${BASH_SOURCE[0]}")
if [[ ${CONTAINER_ID:-} != dev ]]; then
    exec distrobox enter dev --no-tty --no-workdir -- "$launcher" "$@"
fi

# Desktop launches do not inherit the interactive shell's provider paths.
export PATH="$HOME/.local/bin:${VOLTA_HOME:-$HOME/.volta}/bin:${OPENCODE_INSTALL:-$HOME/.opencode}/bin:$PATH"
export T3CODE_DESKTOP_LAUNCHER_PATH="$launcher"
export T3CODE_DISABLE_AUTO_UPDATE=1
exec "${launcher%/*}/current/app/t3code" "$@"
