{
  "id": "org.gnome.Papers",
  "default-branch": "stable",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "runtime-commit": "4337a389125f814785bd83f4ace01da5b6baa80fdcf5a9c81e60dcd03896c067",
  "sdk": "org.gnome.Sdk",
  "sdk-commit": "eb50b0d668d379b1dbfc9acb153425b6100390a94368b0c395ddad3a7d0f64a6",
  "build-options": {
    "cflags": "-O2",
    "cxxflags": "-O2",
    "env": {
      "V": "1",
      "CARGO_BUILD_JOBS": "2",
      "CARGO_PROFILE_RELEASE_LTO": "false"
    },
    "build-args": [
      "--share=network"
    ],
    "append-path": "/usr/lib/sdk/rust-stable/bin:"
  },
  "command": "papers",
  "modules": [
    {
      "name": "popplerdata",
      "no-autogen": true,
      "make-install-args": [
        "prefix=/app"
      ],
      "sources": [
        {
          "url": "https://gitlab.freedesktop.org/poppler/poppler-data.git",
          "commit": "3d16b54346767f2e69c3dcd09d28d762d4a4add5",
          "type": "git"
        }
      ]
    },
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR=/app/lib",
        "-DCMAKE_INSTALL_INCLUDEDIR=/app/include",
        "-DBUILD_GTK_TESTS=OFF",
        "-DBUILD_CPP_TESTS=OFF",
        "-DENABLE_CPP=OFF",
        "-DENABLE_BOOST=OFF",
        "-DENABLE_GOBJECT_INTROSPECTION=OFF",
        "-DENABLE_LIBOPENJPEG=openjpeg2",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF"
      ],
      "sources": [
        {
          "url": "https://gitlab.freedesktop.org/poppler/poppler.git",
          "commit": "a5f33f40726c15ce55495990323431c689151134",
          "type": "git"
        }
      ],
      "cleanup": [
        "/bin"
      ]
    },
    {
      "name": "exempi",
      "config-opts": [
        "--disable-unittest",
        "--disable-samples"
      ],
      "sources": [
        {
          "url": "https://gitlab.freedesktop.org/libopenraw/exempi.git",
          "commit": "9632889bfc9cc35db6386b31706e64433f7fe0ad",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^([\\d.]+)$"
          },
          "type": "git"
        }
      ]
    },
    {
      "name": "djvulibre",
      "config-opts": [
        "--disable-desktopfiles"
      ],
      "sources": [
        {
          "url": "https://downloads.sourceforge.net/project/djvu/DjVuLibre/3.5.29/djvulibre-3.5.29.tar.gz",
          "sha256": "d3b4b03ae2bdca8516a36ef6eb27b777f0528c9eda26745d9962824a3fdfeccf",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 10159,
            "url-template": "https://downloads.sourceforge.net/project/djvu/DjVuLibre/$version/djvulibre-$version.tar.gz"
          },
          "type": "archive"
        }
      ],
      "cleanup": [
        "/bin"
      ]
    },
    {
      "name": "papers",
      "buildsystem": "meson",
      "config-opts": [
        "-Dnautilus=false",
        "-Dthumbnailer=false",
        "-Ddocumentation=false",
        "-Dintrospection=disabled",
        "-Duser_doc=true",
        "-Dprofile=default",
        "-Dtests=false",
        "--libdir=/app/lib",
        "--buildtype=release"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Chipi-Chapa-Corp/papers.git",
          "commit": "ba2ce642db3ca77523bbf791ae87c0b525faee6c",
          "disable-submodules": true
        }
      ]
    }
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "/share/aclocal",
    "/man",
    "/share/man",
    "/share/gtk-doc",
    "/share/vala",
    "*.la",
    "*.a"
  ],
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--talk-name=org.gtk.vfs.*",
    "--filesystem=home:ro",
    "--filesystem=/media:ro",
    "--filesystem=/run/media:ro",
    "--filesystem=xdg-run/gvfsd",
    "--filesystem=xdg-run/gvfs"
  ],
  "copy-icon": true,
  "source-date-epoch": 1793926845
}
